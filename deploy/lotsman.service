[Unit]
Description=Lotsman AmneziaWG gateway
Documentation=https://github.com/anesthetised/lotsman
After=network-online.target
Wants=network-online.target
# A daemon that cannot start (bad config, failed migration) must not restart forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Refuse to start on a config that would not load; the error lands in the journal once, not in a loop.
ExecStartPre=/usr/local/bin/lotsman config check
ExecStart=/usr/local/bin/lotsman serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
Environment=LOTSMAN_CONFIG=/etc/lotsman/lotsman.yaml
StateDirectory=lotsman
StateDirectoryMode=0700
# Root is needed to write /proc/sys, hence CAP_DAC_OVERRIDE. TUN, policy routing
# and nftables need only CAP_NET_ADMIN. CAP_SETUID and CAP_SETGID let the daemon
# start each proxy upstream's helper process as the lotsman-proxy user (uid/gid
# 65534 if it does not exist) without capabilities.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID
ProtectSystem=strict
ReadWritePaths=/var/lib/lotsman
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
