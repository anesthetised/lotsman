[Unit]
Description=Lotsman AmneziaWG 2.0 gateway
Documentation=https://github.com/anesthetised/lotsman
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/lotsman serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
Environment=LOTSMAN_CONFIG=/etc/lotsman/lotsman.yaml
StateDirectory=lotsman
StateDirectoryMode=0700
# Root is needed for TUN creation, sysctls, policy routing and nftables.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE
ProtectSystem=strict
ReadWritePaths=/var/lib/lotsman
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
