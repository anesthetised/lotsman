# Runs the Linux integration tests. Needs NET_ADMIN and /dev/net/tun:
#   docker build -f deploy/Dockerfile.test -t lotsman-test .
#   docker run --rm --privileged lotsman-test            # every package, serially
#   docker run --rm --privileged lotsman-test -v ./internal/tunnel   # go test flags and packages
# CI runs the same image through `just test-integration`.
FROM golang:1.27-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends nftables iptables iproute2 iputils-ping && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# -p 1: the tests share the container's network namespace and interface names.
ENTRYPOINT ["go", "test", "-tags", "integration", "-count=1", "-p", "1"]
CMD ["./..."]
